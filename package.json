{
  "name": "cookorder-level-design-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "mcp": "vite-node src/mcp/server.ts",
    "mcp:typecheck": "tsc -p tsconfig.mcp.json --noEmit",
    "agent-level:append": "vite-node src/mcp/publishAgentLevel.ts",
    "agent-level:publish": "vite-node src/mcp/publishAgentLevel.ts --commit --push --remote github.com --branch master",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/sortablejs": "^1.15.9",
    "sortablejs": "^1.15.7",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-node": "^2.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "zod": "^3.25.76"
  }
}
