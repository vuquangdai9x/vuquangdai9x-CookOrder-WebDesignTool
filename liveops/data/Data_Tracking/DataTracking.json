[
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "level_name",
    "Type": "string",
    "Note": "[GA4] Standard param. '{mapIndex}_{levelIndex}' - globally unique level key. High cardinality: GA4 collapses past ~500 distinct daily values into '(other)', so break down by map_id in console and use BigQuery for per-level work"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "hash",
    "Type": "string",
    "Note": "LevelDataHasher fingerprint of the level config. Changes whenever authored level data changes - use it to compare before/after a retune without a build-version join"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "mode",
    "Type": "string",
    "Note": "Lowercased CookOrderLevelPlayMode"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "map_id",
    "Type": "string",
    "Note": "Authored map id"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "level",
    "Type": "int",
    "Note": "Level index within the map (0-based)"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "level_accumulated",
    "Type": "int",
    "Note": "Global level number = [sum of numRequiredLevels across every map BEFORE this one] + level index. 0-based like `level`, so the first level of the game is 0. Accumulates numRequiredLevels (levels needed to unlock the next map), NOT numMainLevels - so it deliberately does not match the global number the Journey UI shows. -1 when map data is missing; filter level_accumulated >= 0"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "attempt_number",
    "Type": "int",
    "Note": "Attempt count on this level"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_start",
    "Param": "is_replay_after_win",
    "Type": "int",
    "Note": "0/1. ONLY on this event - join to level_end by level_name + attempt_number"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "level_name",
    "Type": "string",
    "Note": "[GA4] Standard param"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "hash",
    "Type": "string",
    "Note": "Same level-config fingerprint as level_start"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "success",
    "Type": "int",
    "Note": "[GA4] Standard param. 1 = win or skip, 0 = lose or quit. NOT win rate - skip also counts as success"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "end_state",
    "Type": "string",
    "Note": "win | skip | lose | quit. Real win rate MUST filter end_state='win'. Skip used to be logged as a plain completion and inflated win rate; this param is what makes it filterable"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "end_reason",
    "Type": "string",
    "Note": "Lowercased LevelEndReason: level_completed, grid_overflow, dirty_overflow, out_of_ingredient, customer_timeout, out_of_serve_slots, belt_deadlock, out_of_hearts, challenge_timeout, challenge_condition_failed, manual_quit, restart, skip, cheat. Quit reason is folded in here"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "mode",
    "Type": "string",
    "Note": "Lowercased playMode"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "map_id",
    "Type": "string",
    "Note": "Authored map id"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "level",
    "Type": "int",
    "Note": "Level index within the map"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "level_accumulated",
    "Type": "int",
    "Note": "= [sum of numRequiredLevels of all previous maps] + level index. 0-based"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "player_type",
    "Type": "string",
    "Note": "bot | player. Sticky once the bot touched the run. Present on ALL outcomes including quit, so bot runs can be filtered out of quit rate too. Always filter player_type != 'bot' before reading any metric"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "attempt_number",
    "Type": "int",
    "Note": "Attempt count on this level"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "duration_sec",
    "Type": "float",
    "Note": "resultData.durationSeconds, or timeCounter.totalTime on quit"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "heart_remaining",
    "Type": "int",
    "Note": "Hearts left. Life-gate pressure: a high share of losses at 0 followed by session end means the gate is ending sessions instead of monetizing them. 0 on quit"
  },
  {
    "Category": "Level Lifecycle",
    "Event": "level_end",
    "Param": "booster_use_count",
    "Type": "int",
    "Note": "Total boosters used in the run (sum over countBoosterUsage)"
  },
